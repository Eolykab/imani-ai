[Unit]
Description=PiPilot Local AI Assistant
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=pipilot
Group=pipilot
WorkingDirectory=/opt/pipilot
EnvironmentFile=/opt/pipilot/.env
ExecStart=/opt/pipilot/.venv/bin/python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/pipilot/data

[Install]
WantedBy=multi-user.target
